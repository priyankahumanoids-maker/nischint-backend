  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "lint": "expo lint",
    "eas-build-pre-install": "if [ -n \"$GOOGLE_SERVICES_JSON\" ] && [ -f \"$GOOGLE_SERVICES_JSON\" ]; then cp \"$GOOGLE_SERVICES_JSON\" ./google-services.json && echo \"[EAS] Copied google-services.json from secret\"; else echo \"[EAS] GOOGLE_SERVICES_JSON not set or not a file\"; fi",
    "test:hc01": "node --import tsx --test __tests__/wearable.fallback.test.ts",
    "test:nisch008": "node --import tsx --test __tests__/emergencyStream.test.ts",
    "test:dpdpmob01": "node --import tsx --test __tests__/privacyScreen.test.ts",
    "test:dpdpmob04": "node --import tsx --test __tests__/consentGate.test.ts",
    "test:hc02": "node --import tsx --test __tests__/healthHistory.test.ts",
    "test:hc03": "node --import tsx --test __tests__/healthKit.test.ts",
    "test:all": "node --import tsx --test __tests__/*.test.ts"
  },
